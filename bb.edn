{:paths ["src" "test" "acceptance"]
 :tasks
 {test {:doc "Run unit tests"
        :task (exec 'htw.test-runner/-main)}
  property {:doc "Run property tests"
            :task (exec 'htw.property-test-runner/-main)}
  inspect {:doc "Inspect a seeded setup through the command-line UI"
           :task (do
                   (require 'htw.cli)
                   (apply (resolve 'htw.cli/inspect) *command-line-args*))}
  acceptance {:doc "Run generated acceptance tests"
              :task (shell "./scripts/acceptance.sh")}}}
